# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/land_acquisition

# Redis (BullMQ Jobs)
REDIS_URL=redis://localhost:6379

# Gemini AI Provider
LLM_PROVIDER=google
LLM_API_KEY=
LLM_MODEL=gemini-.5-flash

# Google Cloud Vision OCR (Optional)
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json

# Storage & Uploads
STORAGE_PATH=./uploads
MAX_FILE_SIZE_MB=50

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
